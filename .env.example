# Modèle de variables d'environnement (sans secret).
# Copier ce fichier en .env.local et y mettre les vraies valeurs.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Cloudflare Turnstile (anti-robot) — clé PUBLIQUE du site. Facultatif :
# si elle est vide, le widget n'est pas affiché. La clé SECRÈTE correspondante
# (TURNSTILE_SECRET_KEY) se configure uniquement dans les secrets de l'Edge Function.
VITE_TURNSTILE_SITE_KEY=
