# Modèle de variables d'environnement (sans secret).
# Copier ce fichier en .env.local et y mettre les vraies valeurs.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Cloudflare Turnstile (anti-robot) — clé PUBLIQUE du site. Facultatif :
# si elle est vide, le widget n'est pas affiché. La clé SECRÈTE correspondante
# (TURNSTILE_SECRET_KEY) se configure uniquement dans les secrets de l'Edge Function.
VITE_TURNSTILE_SITE_KEY=

# Politique de confidentialité (site vitrine de J&J), liée sous le bouton d'envoi.
VITE_PRIVACY_URL=https://j-jtraiteur.fr/confidentialite

# Site vitrine de J&J (lien depuis le logo et la page menu en lecture seule).
VITE_TRAITEUR_SITE_URL=https://j-jtraiteur.fr

# Adresse publique du Composeur, sans « / » final (ex. https://composer.j-jtraiteur.fr).
# Sert aux adresses complètes : image et lien de partage (og:image, og:url),
# liens copiés / envoyés sur WhatsApp. Vide : adresse de la page en cours.
VITE_APP_URL=https://composeur-jj.vercel.app

# Prise de rendez-vous en ligne (Calendly…), ouverte par « Réserver un appel »
# sur la page de confirmation. Vide : le bouton devient « Nous appeler ».
VITE_BOOKING_URL=

# Téléphone de J&J : PAS de variable ici. Source unique = secret Supabase
# TRAITEUR_PHONE, lu par le site via l'Edge Function public-config.
